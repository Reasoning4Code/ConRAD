## Example environment variables for running this project
# Copy this file to .env and fill in your own keys
# DO NOT commit your real .env file to git (it's already in .gitignore)

# OpenAI API Key (required for all scripts)
# Get it from: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-your-openai-api-key-here

# DeepSeek API Key (optional, only needed if using DeepSeek model in guardian)
# Get it from: https://platform.deepseek.com/api_keys
DEEPSEEK_API_KEY=sk-your-deepseek-api-key-here

# GitHub Personal Access Token (required for backward_distillation.py)
# Get it from: https://github.com/settings/tokens
# Needs 'repo' scope to access repository data
GITHUB_TOKEN=ghp_your-github-token-here
